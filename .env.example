# 会话加密密码，留空或保持此占位值时会自动生成并写入 data/.session_password
# 可选，生产环境建议显式设置 32 位以上随机字符串
NUXT_SESSION_PASSWORD=auto-generated-if-empty

# 管理员用户邮箱
CFRAME_ADMIN_EMAIL=
# 管理员用户名（默认为 Chronoframe，可选）
CFRAME_ADMIN_NAME=
# 管理员用户密码（默认为 CF1234@!，可选）
CFRAME_ADMIN_PASSWORD=

# 站点配置
NUXT_PUBLIC_APP_TITLE=ChronoFrame
NUXT_PUBLIC_APP_SLOGAN=记忆藏于镜头之中。
NUXT_PUBLIC_APP_AUTHOR=
NUXT_PUBLIC_APP_AVATAR_URL=
# 颜色模式偏好：light、dark 或 system
NUXT_PUBLIC_COLOR_MODE_PREFERENCE=light

# 地图提供商（mapbox/maplibre/amap）
NUXT_PUBLIC_MAP_PROVIDER=maplibre
# 地图样式 URL
NUXT_PUBLIC_MAP_MAPLIBRE_STYLE=
NUXT_PUBLIC_MAP_MAPBOX_STYLE=
# Mapbox 地图功能访问令牌，Mapbox GL JS（客户端，公开）
NUXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# 高德地图（AMap）JS API 密钥，用于地图显示（客户端，公开）
NUXT_PUBLIC_MAP_AMAP_KEY=
# 高德地图安全码（可选，生产环境推荐使用）
NUXT_PUBLIC_MAP_AMAP_SECURITY_CODE=

# 位置服务提供商（mapbox/nominatim/amap）
NUXT_LOCATION_PROVIDER=
# Mapbox 服务器端密钥访问令牌，用于 Mapbox 搜索 API（逆地理编码）
NUXT_MAPBOX_ACCESS_TOKEN=
# 自定义 Nominatim API 基础地址（在中国大陆官方 API 被屏蔽时，可使用 MapBox 或代理）
NUXT_NOMINATIM_BASE_URL=
# 高德地图（AMap）Web Service API 密钥，用于地理编码（服务器端）
NUXT_LOCATION_AMAP_KEY=

# 存储提供商（local/s3/openlist）
NUXT_STORAGE_PROVIDER=local
# S3 存储提供商配置
NUXT_PROVIDER_S3_ENDPOINT=
NUXT_PROVIDER_S3_BUCKET=
NUXT_PROVIDER_S3_REGION=auto
NUXT_PROVIDER_S3_ACCESS_KEY_ID=
NUXT_PROVIDER_S3_SECRET_ACCESS_KEY=
NUXT_PROVIDER_S3_PREFIX=photos/
NUXT_PROVIDER_S3_CDN_URL=
NUXT_PROVIDER_S3_FORCE_PATH_STYLE=false

# 本地存储提供商配置
NUXT_PROVIDER_LOCAL_PATH=./data/storage

# 本地存储的外部访问基础 URL，例如 /storage（内置 /storage 路由）
NUXT_PROVIDER_LOCAL_BASE_URL=/storage

# OpenList 存储提供商配置
# OpenList 基础地址，例如 https://your-openlist-server.com
NUXT_PROVIDER_OPENLIST_BASE_URL=
# OpenList 根路径，例如 /115pan/chronoframe/photos
NUXT_PROVIDER_OPENLIST_ROOT_PATH=
# 认证方式 - Token 认证（推荐）
NUXT_PROVIDER_OPENLIST_TOKEN=
NUXT_PROVIDER_OPENLIST_ENDPOINT_UPLOAD=/api/fs/put
NUXT_PROVIDER_OPENLIST_ENDPOINT_DOWNLOAD=
NUXT_PROVIDER_OPENLIST_ENDPOINT_LIST=
NUXT_PROVIDER_OPENLIST_ENDPOINT_DELETE=/api/fs/remove
NUXT_PROVIDER_OPENLIST_ENDPOINT_META=/api/fs/get
NUXT_PROVIDER_OPENLIST_PATH_FIELD=path
NUXT_PROVIDER_OPENLIST_CDN_URL=

# GitHub OAuth 应用凭证
NUXT_PUBLIC_OAUTH_GITHUB_ENABLED=false
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# 不安全选项 - 生产环境或公共网络中切勿使用
# 允许在不安全连接上传输 Cookie，影响登录会话安全性
NUXT_ALLOW_INSECURE_COOKIE=false

# Google Analytics 测量 ID（例如 G-XXXXXXX）
NUXT_PUBLIC_GTAG_ID=
# Matomo 分析配置
NUXT_PUBLIC_ANALYTICS_MATOMO_ENABLED=false
NUXT_PUBLIC_ANALYTICS_MATOMO_URL=
NUXT_PUBLIC_ANALYTICS_MATOMO_SITE_ID=

# -----------------
# 上传配置
# -----------------
# 启用文件上传的 MIME 类型白名单验证（默认：true）
NUXT_UPLOAD_MIME_WHITELIST_ENABLED=true

# 允许上传的 MIME 类型列表，以逗号分隔
# 默认包含：image/jpeg, image/png, image/webp, image/gif, image/bmp,
#                   image/tiff, image/heic, image/heif, video/quicktime, video/mp4
NUXT_UPLOAD_MIME_WHITELIST=image/jpeg,image/png,image/webp,image/gif,image/bmp,image/tiff,image/heic,image/heif,image/vnd.radiance,image/x-exr,video/quicktime,video/mp4

# 若要禁用白名单并允许任意文件类型，请设置：
# NUXT_UPLOAD_MIME_WHITELIST_ENABLED=false


# 启用上传时的重复文件检测（默认：true）
NUXT_UPLOAD_DUPLICATE_CHECK_ENABLED=true

# 重复检测模式（默认：跳过）
# - 'warn'：显示警告但允许上传（将覆盖现有照片）
# - 'block'：若文件已存在则拒绝上传
# - 'skip'：跳过上传并返回已有照片信息
NUXT_UPLOAD_DUPLICATE_CHECK_MODE=skip
